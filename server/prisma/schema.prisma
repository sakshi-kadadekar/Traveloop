generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  username  String     @unique
  email     String     @unique
  phone     String?
  password  String
  photo     String?
  city      String?
  country   String?
  role      String     @default("user")
  createdAt DateTime   @default(now())
  trips     Trip[]
  notes     TripNote[]
}

model Trip {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  description String?
  coverPhoto  String?
  status      String        @default("upcoming")
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  stops       Stop[]
  budget      Budget?
  packing     PackingItem[]
  notes       TripNote[]
  invoices    Invoice[]
}

model Stop {
  id         String     @id @default(uuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       String
  country    String?
  startDate  DateTime
  endDate    DateTime
  orderIndex Int
  activities Activity[]
}

model Activity {
  id          String  @id @default(uuid())
  stopId      String
  stop        Stop    @relation(fields: [stopId], references: [id], onDelete: Cascade)
  name        String
  type        String?
  cost        Float   @default(0)
  duration    String?
  timeOfDay   String?
  description String?
}

model Budget {
  id         String @id @default(uuid())
  tripId     String @unique
  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transport  Float  @default(0)
  stay       Float  @default(0)
  meals      Float  @default(0)
  activities Float  @default(0)
  total      Float  @default(0)
}

model PackingItem {
  id       String  @id @default(uuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name     String
  category String?
  isPacked Boolean @default(false)
}

model TripNote {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  day       String?
  stopName  String?
  createdAt DateTime @default(now())
}

model Invoice {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invoiceNo   String
  generatedAt DateTime @default(now())
  travelers   String[]
  items       Json
  total       Float
}
